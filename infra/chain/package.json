{
  "name": "@kami/chain",
  "version": "0.1.0",
  "description": "Idempotent on-chain tooling for Kami: EAS schema registration, Hats tree, Safe deployment (CREATE2), Zodiac Roles v2 allowance, and the pure helpers the platform's signing service calls. Base Sepolia first; mainnet opt-in.",
  "license": "Apache-2.0",
  "author": "Benjamin Life (@omniharmonic)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "kami-chain": "./bin/kami-chain.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "chain": "tsx src/cli.ts"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "2.10.0",
    "@hatsprotocol/sdk-v1-core": "0.12.4",
    "@kami/reputation": "workspace:*",
    "@safe-global/api-kit": "5.0.3",
    "@safe-global/protocol-kit": "8.0.6",
    "ethers": "6.17.0",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
