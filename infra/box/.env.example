# Copy to infra/box/.env on the box (mode 0600). No secrets in this example file; no chain key ever on the box.

# --- images (pin every tag; upgrade only behind the eval suite) ---
VLLM_IMAGE_TAG=v0.11.0             # verify: the tag whose flag set matches README "vllm#42021 check"
HERMES_IMAGE_TAG=v0.21.0           # verify: exact official tag for Hermes v0.21.0 (docs/verify.md #1)
CLOUDFLARED_IMAGE_TAG=2025.8.1     # verify current
OTEL_IMAGE_TAG=0.135.0             # verify current
# TAILSCALE_IMAGE_TAG=v1.86.2      # only if the tailscale tunnel block is enabled

# --- vLLM ---
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_SERVED_NAME=qwen3.5-9b        # must equal model.default in the profiles' config.yaml
VLLM_MAX_NUM_SEQS=8                # global concurrency; sized to the KV budget (README capacity table)
VLLM_GPU_MEM_UTIL=0.92
MODELS_DIR=/opt/models
HF_HUB_OFFLINE=0                   # 1 once the weights are on disk

# --- Hermes ---
HERMES_HOME=/home/hermes/.hermes   # host path mounted at /opt/data in the container
API_SERVER_KEY=                    # one key for the whole gateway (ADR-E02); rotate quarterly; also in Vercel env
PLATFORM_URL=                      # https://<platform> — the precheck and the pause scripts use it
TWIN_BASE_URL=https://data.bioregionaltwin.org
KAMI_PULSE_CONTACT=                # goes into the pulse User-Agent, e.g. ops@<your-domain>

# --- gate ---
GATE_ADMIN_SECRET=                 # X-Gate-Admin for POST/DELETE /admin/pause/<slug> (loopback only)
GATE_PLATFORM_TOKEN=               # bearer the gate presents to the platform's pause-set endpoint

# --- tunnel ---
CLOUDFLARED_TUNNEL_TOKEN=          # from the Cloudflare dashboard; exposes 127.0.0.1:8642 only
# TS_AUTHKEY=                      # tailscale alternative

# --- backup (see backup.sh; put these in /etc/kami/backup.env rather than here if the box is shared) ---
BACKUP_AGE_RECIPIENT=              # age1… public key; the private half never lives on the box
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kami-data
R2_PREFIX=backups/hermes
