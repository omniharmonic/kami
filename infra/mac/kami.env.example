# kami.env — the Mac's environment file. Copy to ~/.kami/kami.env, chmod 600, fill in.
#
# install.sh does the copy for you and never overwrites an existing file. The launchd plists
# do NOT contain any of this: bin/run-gate.sh and bin/run-hermes.sh read this file at start,
# so nothing here appears in `launchctl print` or in a world-readable plist.
#
# Every variable, what reads it and what happens without it: docs/deploy/env.md.
# Re-read after editing:  launchctl kickstart -k gui/$(id -u)/com.kami.gate

# ---- the model upstream ----------------------------------------------------------------
# The key itself lives here; gate.yaml only names this variable (upstream_api_key_env).
OPENAI_API_KEY=

# ---- the gate <-> platform shared secret -------------------------------------------------
# The same value must be set in the Vercel project. The gate polls the pause set with it and
# posts heartbeats with it; when the two differ, a guardian's pause never reaches this Mac.
GATE_ADMIN_SECRET=

# The gate authenticates to the platform with this when platform.token_env says so.
KAMI_PLATFORM_TOKEN=

# ---- the entity's own token --------------------------------------------------------------
# Minted per entity on the platform; scoped to one slug. Used by the pulse precheck and the
# treasury MCP. Also written into ~/.hermes/profiles/<slug>/.env by deploy-profile.
PLATFORM_MCP_TOKEN=

# ---- Hermes -------------------------------------------------------------------------------
# The gateway's API key. The same value goes in the Vercel project as HERMES_API_SERVER_KEY.
API_SERVER_KEY=
# Dedicated profile; the wrapper refuses to fall back to your personal default.
KAMI_HERMES_PROFILE=
API_SERVER_PORT=8642

# ---- where things are ---------------------------------------------------------------------
PLATFORM_URL=https://<your-deployment>.vercel.app
TWIN_BASE_URL=https://data.bioregionaltwin.org
KAMI_PULSE_CONTACT=you@example.com        # goes in the User-Agent when reading the twin
KAMI_GATE_URL=http://127.0.0.1:8001
HERMES_GATEWAY_URL=http://127.0.0.1:8642

# The URL the *platform* uses to reach this Mac — the tunnel hostname, not localhost.
# `kami doctor --only tunnel` checks this one is reachable from outside.
KAMI_PUBLIC_GATEWAY_URL=https://gw.<your-domain>

# ---- optional -----------------------------------------------------------------------------
# KAMI_GATE_YAML=/Users/you/kami/apps/gate/gate.yaml   # default: the repo's copy
# KAMI_GATE_LISTEN=127.0.0.1:8001
# HERMES_HOME=/Users/you/.hermes
# KAMI_ENV=production   # makes the gate refuse to start with passthrough on, or fail_closed off
