# Copy to apps/web/.env.local for development. Never commit real values.
DATABASE_URL=postgres://user:pass@host/kami          # Neon pooled connection string
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
KAMI_DATA_DIR=./data-local                           # local stand-in for the R2 bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kami-data
TWIN_BASE_URL=https://data.bioregionaltwin.org
TWIN_TREE_DIR=../../packages/twin-mcp/fixtures/public # dev: read the fixture tree instead
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_API_SERVER_KEY=
GATE_ADMIN_SECRET=
HERMES_WEBHOOK_SECRET=
CRON_SECRET=
PARACHUTE_HUB_URL=https://agent.omniharmonic.com
PARACHUTE_ENTITIES_VAULT=entities
PARACHUTE_ENTITIES_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
CHAIN_ID=84532
RPC_URL_BASE=https://sepolia.base.org
SIGNING_BACKEND=local                                # local | privy | aws-kms
PASSPORT_API_KEY=

# --- Set before a first deploy; several of these fail closed rather than half-work.
PLATFORM_URL=http://localhost:3000                    # base the box calls back on
PLATFORM_ADMIN_TOKEN=                                 # /api/admin/config, chain scripts' HTTP store
KAMI_DATA_BASE_URL=                                   # public base URL of the bucket; unset means pages read the local dir
CHAT_COOKIE_SECRET=                                   # signs the anonymous chat cookie
CAPTURE_TOKEN_SECRET=                                 # signs in-app capture proofs; unset means evidence cannot prove it came through the app
TRUSTED_PROXY_HOPS=1                                  # proxies in front of us; 1 on Vercel. Wrong value = a bypassable per-IP rate limit
KAMI_ENV=development                                  # "production" makes the gate refuse an unguarded or fail-open config
RESEND_FROM=
KAMI_PULSE_CONTACT=                                   # contact address in the User-Agent the twin sees

# --- The model upstream (apps/gate reads these; the key is named, never inlined)
OPENAI_API_KEY=
CF_ACCESS_CLIENT_ID=                                  # only if the tunnel is behind Cloudflare Access
CF_ACCESS_CLIENT_SECRET=
