{
  "name": "@kami/reputation",
  "version": "0.1.0",
  "description": "reputation/v1 — a deterministic pure function over EAS ProposalOutcome attestations, plus the recompute CLI that reproduces the nightly file byte-for-byte.",
  "license": "Apache-2.0",
  "author": "Benjamin Life (@omniharmonic)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kami-reputation-recompute": "./dist/recompute.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
