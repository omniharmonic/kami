{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.bioregionaltwin.org/schema/place-set-binding-1.0.json",
  "title": "Place-set binding (place-set-binding-1.0)",
  "description": "A set of twin ids an entity senses through (architecture §3). A twin 'place set' document: it names twin ids, roles and needs, and knows nothing about the platform that holds it. URLs only — a binding stores no geometry.",
  "type": "object",
  "required": ["schema_version", "binding_version", "entity_id", "archetype", "anchor", "members", "watersheds", "needs", "frozen_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "binding_version": { "type": "integer", "minimum": 0, "description": "Immutable per version; 0 is a proposal (resolve_entity on a twin id) that no steward has frozen." },
    "entity_id": { "type": "string", "pattern": "^entity/[a-z0-9-]+$" },
    "archetype": { "type": "string", "enum": ["creek", "watershed", "reservoir", "mountain", "bioregion"] },
    "anchor": { "$ref": "#/$defs/twinId" },
    "stream_id": { "oneOf": [{ "$ref": "#/$defs/twinId" }, { "type": "null" }] },
    "commons_handle": { "type": ["string", "null"] },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/twinId" },
          "role": { "type": "string", "enum": ["main_stem_gauge", "gauge", "snotel", "reservoir", "water_quality", "air", "weather", "other"] }
        }
      }
    },
    "watersheds": { "type": "array", "items": { "$ref": "#/$defs/twinId" } },
    "reach_ids": { "type": "array", "items": { "type": "string" } },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry_urls": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["need", "property", "places", "agg"],
        "additionalProperties": false,
        "properties": {
          "need": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "property": { "type": "string" },
          "places": { "type": "array", "items": { "$ref": "#/$defs/twinId" } },
          "agg": { "type": "string", "enum": ["single", "mean", "median", "min", "max", "mean_24h", "max_intersecting"] },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "membership_rule": { "type": ["string", "null"] },
    "frozen_at": { "type": "string", "format": "date-time" },
    "reviewed_by": { "type": ["string", "null"] },
    "twin_index_etag": { "type": ["string", "null"] }
  },
  "$defs": {
    "twinId": { "type": "string", "pattern": "^[a-z_]+/[a-z0-9-]+$" }
  }
}
